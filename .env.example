# Copy to .env (gitignored). Credentials live here only: never in prompts, logs, containers or commits.

# Model runs (orchestrator.run, analysis/self_blame.py, analysis/exp03.py). Only needed for Claude models;
# an `ant auth login` profile also works.
ANTHROPIC_API_KEY=
# Ollama's OpenAI-compatible endpoint, for the free qwen3:8b plumbing runs.
OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional: where the host reaches Gitea. Unset, it's read from the hl-agents network (orchestrator/sandbox.py).
HL_GITEA_URL=

# Track B gateway (gateway/), only for --live. Untested live; nothing has been posted.
X_USER_ACCESS_TOKEN=
X_USER_ID=
# Optional: per-call X prices for the gateway's cost log. Unset, costs are logged as unknown.
X_COST_PER_POST_USD=
X_COST_PER_LINK_POST_USD=
X_COST_PER_READ_USD=
# Only for --live-github: the org that mirrors are created in (private) and a token scoped to it.
GITHUB_TOKEN=
GITHUB_ORG=

# Not read from .env; set them in the shell when needed:
#   OLLAMA_CONTEXT_LENGTH=16384   for `ollama serve` (its default context truncates silently)
#   CHROME=<path>                 headless Chrome for scripts/og_image.sh
#   PAGES_BRANCH=<name>           deploy the site to another branch (tests of scripts/publish_runs.sh)
